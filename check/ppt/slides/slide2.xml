29"/></a:solidFill><a:latin typeface="Noto Sans CJK JP" pitchFamily="34" charset="0"/><a:ea typeface="Noto Sans CJK JP" pitchFamily="34" charset="-122"/><a:cs typeface="Noto Sans CJK JP" pitchFamily="34" charset="-120"/></a:rPr><a:t>じゃらん口コミ4.9（726件）と体験満足度は非常に高い。しかし、「inimuらしさ（他店と異なる固有価値）」が一般的な口コミの言葉（楽しかった・丁寧等）に隠れて残っていない可能性（仮説）。</a:t></a:r><a:endParaRPr lang="en-US" sz="1020" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Shape 10"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6035040" y="4389120"/><a:ext cx="4160520" cy="0"/></a:xfrm><a:prstGeom prst="line"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln w="8890"><a:solidFill><a:srgbClr val="B8B2AA"/></a:solidFill><a:prstDash val="solid"/><a:headEnd type="none"/><a:tailEnd type="none"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="Text 11"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6035040" y="4535424"/><a:ext cx="4160520" cy="164592"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="700" spc="140" kern="0" dirty="0"><a:solidFill><a:srgbClr val="7A7771"/></a:solidFill><a:latin typeface="Noto Sans CJK JP" pitchFamily="34" charset="0"/><a:ea typeface="Noto Sans CJK JP" pitchFamily="34" charset="-122"/><a:cs typeface="Noto Sans CJK JP" pitchFamily="34" charset="-120"/></a:rPr><a:t>企画の軸</a:t></a:r><a:endParaRPr lang="en-US" sz="700" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="Text 12"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6035040" y="4818888"/><a:ext cx="4160520" cy="960120"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr w